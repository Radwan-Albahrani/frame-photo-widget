language js

or {
  `$object.alert($...)` where {
    $object <: `Alert`,
    register_diagnostic(span=$object, message="Alert.alert is banned. Use Sheet from src/ui/Sheet.tsx: PromptSheet for text entry and ConfirmSheet for a destructive decision. A system alert cannot be styled, cannot be dismissed by gesture and reads like a bug report.")
  },
  identifier() as $identifier where {
    $identifier <: `ActionSheetIOS`,
    register_diagnostic(span=$identifier, message="ActionSheetIOS is banned. Use Sheet from src/ui/Sheet.tsx, which is themed, gesture-dismissable and works the same on every surface.")
  }
}
