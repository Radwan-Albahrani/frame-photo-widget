{
  "name": "photo-widget",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "prebuild": "expo prebuild",
    "ios": "bun run prebuild && expo run:ios",
    "types:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "lint:comments": "bun tools/lints/no-new-comments.ts",
    "lint:silent": "bun tools/lints/no-silent-failures.ts",
    "lint:comments:branch": "bun tools/lints/no-new-comments.ts --base main --head HEAD",
    "lint:silent:branch": "bun tools/lints/no-silent-failures.ts --base main --head HEAD",
    "lint:commit": "bun tools/lints/commit-message.ts",
    "hooks:install": "git config core.hooksPath .githooks",
    "db:generate": "drizzle-kit generate && bun run db:bundle",
    "db:bundle": "bun run scripts/bundleMigrations.ts",
    "gates": "bun run types:check && bun run lint && bun run lint:silent:branch && bun run format && bun run test"
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "^18.2.3",
    "@expo/vector-icons": "^15.1.1",
    "drizzle-orm": "^1.0.0-rc.4",
    "expo": "~57.0.24",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.21",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "i18next": "^26.4.2",
    "react": "19.2.8",
    "react-i18next": "^17.0.12",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-reanimated": "~4.5.5",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "4.27.0",
    "react-native-worklets": "~0.11.4"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.5",
    "@babel/types": "^8.0.5",
    "@bacons/apple-targets": "^5.0.0",
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.18",
    "bun-types": "^1.4.2",
    "drizzle-kit": "^1.0.0-rc.4",
    "typescript": "~7.0.2",
    "vitest": "^4.1.11"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-native-gesture-handler",
        "react-native-reanimated",
        "react-native-safe-area-context",
        "react-native-screens",
        "react-native-worklets",
        "typescript"
      ]
    }
  },
  "overrides": {
    "react": "19.2.8",
    "react-native-screens": "4.27.0"
  }
}
