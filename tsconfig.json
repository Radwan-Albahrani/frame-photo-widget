{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "@assets/*": ["./assets/*"],
      "@backend/*": ["./src/backend/*"],
      "@native/*": ["./src/native/*"],
      "@ui/*": ["./src/ui/*"],
      "@const/*": ["./src/const/*"],
      "@i18n": ["./src/i18n"],
      "@i18n/*": ["./src/i18n/*"],
      "@react-navigation/core": ["./node_modules/expo-router/build/react-navigation/core"]
    },
    "types": ["node", "bun-types"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
